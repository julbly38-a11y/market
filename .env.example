SUPABASE_URL=https://ubjnztanehqlsrqphdqy.supabase.co
SUPABASE_SERVICE_KEY=paste-service-role-key-here

# MyDrop (mydrop.com.ua) — роль dropshipper, https://api.mydrop.com.ua/
MYDROP_API_KEY=paste-mydrop-api-key-here

# mono pay (monobank business → еквайринг), токен мерчанта
MONO_TOKEN=paste-mono-merchant-token-here

# Публічна адреса сайту (редірект після оплати, вебхук)
SITE_URL=https://forpost-shop.vercel.app

# Ключ доступу до /api/finance (заголовок X-Finance-Key); без нього ендпоінт вимкнено
FINANCE_KEY=paste-long-random-string

# Особистий токен monobank (https://api.monobank.ua) — виписка власного рахунку для витрат; необов'язково
MONO_PERSONAL_TOKEN=paste-personal-token-here

# Prom.ua: токен API і доступ до YML-фіду (/api/feed/prom?key=...); групи через ";", націнка у відсотках
PROM_API_TOKEN=paste-prom-api-token-here
PROM_FEED_KEY=paste-long-random-string
# PROM_GROUPS=Акумуляторні станції та енергія
# PROM_MARKUP_PERCENT=0
# Секрет для cron-ендпоінтів (Vercel додає його як Authorization: Bearer ...)
CRON_SECRET=paste-long-random-string

# Ціноутворення: націнка сайту, єдиний податок (ФОП 3 група) і комісія еквайрингу, %
SITE_MARKUP_PERCENT=0
TAX_PERCENT=5
MONO_FEE_PERCENT=1.3

# Дані продавця (ФОП) для сторінки /oferta
SELLER_NAME=
SELLER_TAXID=
SELLER_ADDRESS=
SELLER_EMAIL=
